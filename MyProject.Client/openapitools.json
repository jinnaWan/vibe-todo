{
  "$schema": "./node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.13.0",
    "generators": {
      "typescript-axios": {
        "generatorName": "typescript-axios",
        "inputSpec": "http://localhost:5102/swagger/v1/swagger.json",
        "output": "./src/generated",
        "additionalProperties": {
          "npmName": "myproject-api-client",
          "npmVersion": "1.0.0",
          "supportsES6": true,
          "withInterfaces": true,
          "modelPropertyNaming": "camelCase"
        }
      }
    }
  }
}
