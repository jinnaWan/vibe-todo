# Frontend ECS Runner Configuration
# AWS ECS Configuration
ECS_CLUSTER=github-runners-cluster
TASK_DEFINITION=github-runner-task
CAPACITY_PROVIDER=EC2
CONTAINER_NAME=github-runner

# Resource Configuration - Moderate resources for Node.js builds
CONTAINER_MEMORY=3072
CONTAINER_CPU=1536

# Network Configuration (optional - will use default VPC if not specified)
SECURITY_GROUPS=
SUBNETS=

# Runner Configuration
RUNNER_LABELS=self-hosted,aws-ecs,linux,arm64,nodejs,frontend 